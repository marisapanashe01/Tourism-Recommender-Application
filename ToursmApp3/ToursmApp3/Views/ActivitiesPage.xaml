<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToursmApp3.Views.ActivitiesPage"
             Title="Activities and Events"
             BackgroundColor="AliceBlue">

    <ScrollView>
        <StackLayout Padding="10">

            <Label Text="Upcoming Activities and Events"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="DarkGoldenrod"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />

            <CollectionView ItemsSource="{Binding Activities}" 
                            Margin="0,0,0,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                               CornerRadius="10"
                               Padding="10"
                               HasShadow="True">
                            <StackLayout>
                                <Image Source="{Binding ImageSource}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="250" 
                                       Margin="0,0,0,10"/>
                                <Label Text="{Binding Title}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"/>
                                <Label Text="{Binding Description}" 
                                       FontSize="14" 
                                       TextColor="Gray"/>
                                <Label Text="{Binding Location}" 
                                       FontSize="14" 
                                       FontAttributes="Italic" 
                                       TextColor="DarkOliveGreen"/>
                                <Label Text="{Binding EventTime, StringFormat='Event Date: {0:MMMM dd, yyyy}'}" 
                                       FontSize="14" 
                                       TextColor="Black"/>
                                <Label Text="{Binding ContactPhone}" 
                                       FontSize="14" 
                                       TextColor="Black"/>
                                <Label Text="{Binding ContactEmail}" 
                                       FontSize="14" 
                                       TextColor="Black"/>
                                <Label Text="{Binding Status}" 
                                       FontSize="14" 
                                       TextColor="Orange" 
                                       FontAttributes="Bold"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>