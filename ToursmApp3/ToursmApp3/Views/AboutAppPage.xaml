             x:Class="ToursmApp3.Views.AboutAppPage"
             Title="About this App"
             BackgroundColor="#F0F8FF">
    <!-- Light background color -->

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Title -->
            <Label Text="About This App" 
