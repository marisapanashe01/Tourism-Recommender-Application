<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToursmApp3.Views.RestaurantsPage"
             Title="Restaurants"
             BackgroundColor="AliceBlue">

    <StackLayout Padding="10">
        <Label Text="Restaurants Near Tourist Attractions"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="DarkGoldenrod"
               HorizontalOptions="Center"
               Margin="0,10,0,20" />

        <CollectionView ItemsSource="{Binding Restaurants}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="WhiteSmoke"
                           CornerRadius="10"
                           Padding="10"
                           HasShadow="True">
                        <StackLayout>
                            <Image Source="{Binding ImageSource}" Aspect="AspectFill" HeightRequest="200" />
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                            <Label Text="{Binding Description}" FontSize="14" TextColor="Gray" FontAttributes="Italic" />
                            <Label Text="{Binding Location}" FontSize="14" TextColor="DarkOliveGreen" />
                            <Label Text="Directions:" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding Directions}" FontSize="14" TextColor="Black" />

                            <!-- Star Rating -->
                            <Label Text="{Binding StarRating}" FontSize="14" TextColor="Gold" Margin="0,5,0,5" />

                            <Label Text="Contact:" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding ContactPhone}" FontSize="14" TextColor="Black" FontAttributes="Italic" />
                            <Label Text="{Binding ContactEmail}" FontSize="14" TextColor="Black" FontAttributes="Italic" />

                            <!-- Show Menu Button -->
                            <Button Text="Show Menu" Clicked="OnShowMenuClicked" />

                            <!-- CarouselView for menu images, initially hidden -->
                            <StackLayout x:Name="MenuContainer" IsVisible="False" Margin="0,5,0,0">
                                <Label Text="Menu:" FontAttributes="Bold" TextColor="DarkGoldenrod" Margin="0,5,0,5" />

                                <!-- Arrow and Swipe Text -->
                                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,5">
                                    <Label Text="Swipe Menu Left to View More" VerticalOptions="Center" 
                                           TextColor="DarkGoldenrod" FontAttributes="Italic" Margin="5,0" />
                                </StackLayout>

                                <CarouselView ItemsSource="{Binding MenuImages}" HeightRequest="300">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding}" Aspect="AspectFit" HeightRequest="300" />
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>
                            </StackLayout>

                            <Button Text="View on Map" Clicked="OnViewMapClicked" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>