<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToursmApp3.Views.IconicMonumentsPage"
             Title="Iconic Monuments and Landscapes"
             BackgroundColor="WhiteSmoke">

    <ScrollView>
        <StackLayout Padding="10">

            <Label Text="Iconic Monuments and Landscapes" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="DarkGoldenrod" 
                   HorizontalOptions="Center" 
                   Margin="0,10" />

            <CollectionView ItemsSource="{Binding Monuments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="5">
                            <Frame Padding="0" Margin="5" HasShadow="True" CornerRadius="10" BackgroundColor="White">
                                <Image Source="{Binding ImageSource}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="200" />
                            </Frame>
                            <Label Text="{Binding Name}" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="Black" 
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding Description}" 
                                   FontSize="14" 
                                   TextColor="Gray" 
                                   Margin="0,5" 
                                   HorizontalOptions="Center" />
                            <Label Text="History:" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding History}" FontSize="14" FontAttributes="Italic" TextColor="Gray" />
                            <Label Text="{Binding ContactEmail}" FontSize="14" TextColor="Black" FontAttributes="Italic" />
                            <Label Text="Directions:" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding Directions}" FontSize="14" TextColor="Gray" />
                            <Label Text="Location:" 
                                   FontAttributes="Bold" 
                                   TextColor="Black" />
                            <Label Text="{Binding Location}" 
                                   FontSize="14" 
                                   TextColor="Gray" />
                            <Label Text="{Binding ContactPhone}" FontSize="14" TextColor="Gray" FontAttributes="Italic" />

                            <Button Text="View on Map" 
                                    BackgroundColor="DarkGoldenrod" 
                                    TextColor="White" 
                                    Clicked="OnViewMapClicked" 
                                    CommandParameter="{Binding Location}" 
                                    Margin="0,10" 
                                    HorizontalOptions="Center" 
                                    WidthRequest="150" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>