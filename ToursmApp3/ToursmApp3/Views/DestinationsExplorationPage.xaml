<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ToursmApp3.ViewModels"
             x:Class="ToursmApp3.Views.DestinationsExplorationPage"
             Title="Explore Destinations"
             BackgroundColor="AliceBlue">

    <ScrollView>
        <StackLayout Padding="10">

            <!-- Page Title -->
            <Label Text="Explore Zimbabwe's Destinations"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="DarkGoldenrod"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />
            <!-- Swipe Notification -->
            <Label Text="Browse Destinations Below"
                   FontSize="12"
                   FontAttributes="Italic"
                   TextColor="DarkSlateGray"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,10,10,20" />

            <!-- CollectionView for Displaying Destinations -->
            <CollectionView ItemsSource="{Binding Destinations}" SelectionMode="Single" SelectionChanged="OnDestinationSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItem Text="Favorite" BackgroundColor="LightGreen"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToFavoritesCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeView.RightItems>
                            <Frame BackgroundColor="WhiteSmoke" CornerRadius="10" HasShadow="True" Padding="5">
                                <StackLayout>
                                    <Image Source="{Binding ImageSource}" Aspect="AspectFill" HeightRequest="150" />
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                                    <Label Text="{Binding Description}" FontSize="14" TextColor="Black" />
                                </StackLayout>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>