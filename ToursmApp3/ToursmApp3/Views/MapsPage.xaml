<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToursmApp3.Views.MapsPage"
             Title="Maps"
             BackgroundColor="WhiteSmoke">

    <ScrollView>
        <StackLayout Padding="10">

            <Label Text="Explore Zimbabwe with Maps" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="DarkGoldenrod" 
                   HorizontalOptions="Center" 
                   Margin="0,10" />

            <CollectionView ItemsSource="{Binding Maps}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="5">
                            <Frame Padding="0" Margin="5" HasShadow="True" CornerRadius="10" BackgroundColor="White">
                                <Image Source="{Binding ImageSource}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="200" />
                            </Frame>
                            <Label Text="{Binding Name}" 
                                   FontSize="18" 
                                   FontAttributes="Italic" 
                                   TextColor="Black" 
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding Description}" 
                                   FontSize="14" 
                                   TextColor="Gray"
                                   FontAttributes="Italic"
                                   Margin="0,5" 
                                   HorizontalOptions="Center" />
                          
                            <Button Text="View In Maps" 
                                    BackgroundColor="DarkGoldenrod" 
                                    TextColor="White" 
                                    Clicked="OnViewMapClicked" 
                                    CommandParameter="{Binding Location}" 
                                    Margin="0,20,0,0" 
                                    HorizontalOptions="Center" 
                                    WidthRequest="300" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>